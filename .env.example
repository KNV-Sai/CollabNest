###############################################
# CollabNest environment template
###############################################

# ---------- Backend (Spring Boot) ----------
# Copy these to your system environment before running server
# or use your IDE run configuration environment variables.

# JWT signing secret (must be long and random in production)
APP_JWT_SECRET=change_this_to_a_long_random_secret_for_production

# Comma-separated list of frontend origins allowed by CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Frontend (Vite) ----------
# Create frontend/.env and set:
# VITE_API_BASE_URL=http://localhost:8080/api